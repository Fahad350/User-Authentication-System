
<% provide(:title, "All users") %>

<h1>All users</h1>

<%= will_paginate @users %>

<ul class="users">
  <% @users.each do |user| %>
    <li>
      <%= link_to user.name, user %>

      <% if current_user.admin? && !current_user?(user) %>
        | <%= link_to "delete", user,
              data: {
                "turbo-method": :delete,
                turbo_confirm: "Are you sure?"
              } %>
      <% end %>
    </li>
  <% end %>
</ul>

<%= will_paginate @users %>

